# All optional for a basic run. Without DATABASE_URL the app uses an embedded PGLite database.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
VITE_AUTH_ENABLED=
# Builder-platform (Grok) auth/connectors - only needed if you use sign-in or connectors
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
XAI_API_KEY=

