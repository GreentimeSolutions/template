{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tip-risk-sweep",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/ledger-anchor",
      "schedule": "30 6 * * *"
    }
  ]
}
